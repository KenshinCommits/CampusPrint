# ---- Copy this file to .env and fill in ----

# "local" = zero AWS setup, data stored in backend/data/*.json (great for hours 0-6)
# "dynamodb" = real AWS DynamoDB (switch to this once you deploy, or whenever you're ready)
DB_DRIVER=local

PORT=4000
JWT_SECRET=dev-secret-change-me-before-deploying
CORS_ORIGIN=http://localhost:5173

# ---- Only needed when DB_DRIVER=dynamodb ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
USERS_TABLE=campusprint-users
ORDERS_TABLE=campusprint-orders

# Pricing (INR) - tune these to your actual shop's rates, it makes the demo feel real
RATE_BW_PER_PAGE=2
RATE_COLOR_PER_PAGE=8
BINDING_FEE_STAPLE=0
BINDING_FEE_SPIRAL=20
